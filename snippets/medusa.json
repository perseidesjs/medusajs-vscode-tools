{
	"Medusa - Route GET": {
		"prefix": "mrg",
		"description": "Creates a new GET API route for Medusa.js",
		"body": [
			"import type {",
			"  MedusaRequest,",
			"  MedusaResponse,",
			"} from \"@medusajs/framework/http\"",
			"",
			"export const GET = (",
			"  req: MedusaRequest,",
			"  res: MedusaResponse",
			") => {",
			"  $1",
			"  res.json({",
			"    message: \"[GET] Hello world!\",",
			"  })",
			"}"
		]
	},
	"Medusa - Route POST": {
		"prefix": "mrp",
		"description": "Creates a new POST API route for Medusa.js",
		"body": [
			"import type {",
			"  MedusaRequest,",
			"  MedusaResponse,",
			"} from \"@medusajs/framework/http\"",
			"",
			"export const POST = async (",
			"  req: MedusaRequest,",
			"  res: MedusaResponse",
			") => {",
			"  // Add your POST logic here",
			"  $1",
			"  res.status(201).json({",
			"    message: \"[POST] Hello world!\",",
			"  })",
			"}"
		]
	},
