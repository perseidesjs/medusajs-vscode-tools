	"Medusa - Route DELETE": {
		"prefix": "mrd",
		"description": "Creates a new DELETE API route for Medusa.js",
		"body": [
			"import type {",
			"  MedusaRequest,",
			"  MedusaResponse,",
			"} from \"@medusajs/framework/http\"",
			"",
			"export const DELETE = async (",
			"  req: MedusaRequest,",
