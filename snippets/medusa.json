	"Medusa - Workflow": {
		"prefix": "mw",
		"description": "Creates a new Medusa.js workflow",
		"body": [
			"import {",
			"  createWorkflow,",
			"  WorkflowResponse,",
			"} from \"@medusajs/framework/workflows-sdk\"",
			"",
			"type WorkflowInput = {}",
			"",
			"const myWorkflow = createWorkflow(",
			"  \"${1:workflow-name}\",",
			"  function (input: WorkflowInput) {",
			"    // Use your steps here",
			"    $2",
			"    return new WorkflowResponse(\"Done!\")",
			"  }",
			")",
			"",
			"export default myWorkflow"
		]
	},
	"Medusa - Workflow Step": {
		"prefix": "mws",
		"description": "Creates a new Medusa.js workflow step",
		"body": [
			"import { createStep, StepResponse } from \"@medusajs/framework/workflows-sdk\"",
			"",
			"type StepInput = {}",
			"",
			"export const ${1:stepName} = createStep(",
			"    \"${2:unique-step-id}\",",
			"    async (input: StepInput, { container }) => {",
			"        $3",
			"        return new StepResponse('Step completed!')",
			"    }",
			")"
		]
	},
	"Medusa - Middleware Route": {
		"prefix": "mrm",
		"description": "Creates a new Medusa.js middleware route configuration",
		"body": [
			"import { MiddlewareRoute } from \"@medusajs/framework\"",
			"",
			"export const ${1:middlewareName}: MiddlewareRoute[] = [",
			"    {",
			"        method: [\"${2:GET}\"],",
			"        matcher: \"${3:/store/custom/*}\",",
			"        middlewares: [\"${4:authenticate}\"]",
			"    }",
			"]"
		]
	},
	"Medusa - Route Validator": {
		"prefix": "mrv",
		"description": "Creates a new Medusa.js route validator",
		"body": [
			"import { z } from \"zod\";",
			"",
			"export const ${1:ValidatorName} = z.object({",
			"  $2",
			"})",
			"",
			"export type ${1:ValidatorName}Type = z.infer<typeof ${1:ValidatorName}>"
		]
	},
	"Medusa - Subscriber": {
		"prefix": "mss",
		"description": "Creates a new Medusa.js subscriber",
		"body": [
			"import type { SubscriberConfig, SubscriberArgs } from \"@medusajs/medusa\"",
			"",
			"type EventData = { ${3:id: string} }",
			"",
			"export default async function ${2:${1/^(.)|[\\.\\-]+(.)/${1:/downcase}${2:/upcase}/g}}Handler({",
			"    event: { data },",
			"    container,",
			"}: SubscriberArgs<EventData>) {",
			"    $0",
			"}",
			"",
			"export const config: SubscriberConfig = {",
			"    event: \"${1:product.created}\",",
			"}",
		]
	},
}
